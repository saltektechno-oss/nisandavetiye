# ---------------------------------------------------------------------------
# Bu dosyayi kopyalayip ".env.local" adiyla kaydet ve degerleri doldur.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Formspree form adresi (RSVP formu buraya gonderilir).
# 1) formspree.io adresinde ucretsiz hesap ac
# 2) "New Form" -> forma bir isim ver
# 3) Sana verdigi endpoint'i asagiya yapistir (https://formspree.io/f/xxxxxxxx)
# Bos birakirsan form calisir ama gonderimde "form henuz baglanmadi" uyarisi verir.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Sitenin canli adresi. /qr sayfasindaki QR kod bu adrese gider.
# Netlify'a deploy ettikten sonra gercek adresle degistir.
NEXT_PUBLIC_SITE_URL=https://kevser-tahir.netlify.app
